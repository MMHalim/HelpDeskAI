{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @helpdesk/shared build && pnpm --filter @helpdesk/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE_WITH_API_HOST/api/:path*"
    },
    {
      "source": "/slack/:path*",
      "destination": "https://REPLACE_WITH_API_HOST/slack/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
