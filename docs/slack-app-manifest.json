{
  "display_information": {
    "name": "HelpDeskAI",
    "description": "IT troubleshooting assistant for support agents",
    "background_color": "#1d4ed8"
  },
  "features": {
    "bot_user": {
      "display_name": "HelpDeskAI",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "app_mentions:read",
        "reactions:read",
        "reactions:write",
        "files:read",
        "users:read",
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://train-tsunami-peer-presentations.trycloudflare.com/slack/events",
      "bot_events": [
        "app_mention",
        "reaction_added",
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim",
        "file_shared",
        "file_created"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://train-tsunami-peer-presentations.trycloudflare.com/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}