# ==============================================================================
# HelpDeskAI — environment configuration
# Copy to `.env` and fill in real values. NEVER commit the real `.env` file.
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
# Public base URL of this API. Slack must be able to reach it (needs HTTPS in prod).
PUBLIC_API_URL=http://localhost:4000
# Comma separated list of allowed CORS origins for the admin dashboard.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Database (Supabase PostgreSQL or any PostgreSQL 14+)
#   Supabase: Project Settings -> Database -> Connection string (URI)
#   The direct host (db.<ref>.supabase.co) is IPv6-only; on IPv4 networks use
#   the "Session pooler" URI: postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/helpdesk_ai
# "session" for the direct/session-pooler (prepared statements supported);
# "transaction" for the transaction pooler (port 6543).
DATABASE_POOL_MODE=transaction
# "ssl" | "disable" (use "ssl" for Supabase)
DATABASE_SSL=disable
# Optional: Supabase project URL + service role key (used when FILE_STORAGE=supabase
# or other Supabase REST features). The anon/publishable key is not used by the API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=helpdesk-ai
# Optional: use the Supabase Storage REST API instead of local disk for files.
# When true, SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are required.
FILE_STORAGE=local
STORAGE_LOCAL_DIR=./storage
# Public URL prefix under which locally stored files are served by the API.
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/api/files

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
# 32-byte key, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
# First admin account, created by `pnpm db:seed`. Change the password immediately.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_Admin_2026!
# Session lifetime for the admin dashboard, in hours.
SESSION_TTL_HOURS=12
# Salt + pepper used when hashing session tokens.
SESSION_PEPPER=change-me-session-pepper

# ------------------------------------------------------------------------------
# Slack app credentials — https://api.slack.com/apps
# ------------------------------------------------------------------------------
# Bot User OAuth Token (xoxb-...) — App -> OAuth & Permissions
SLACK_BOT_TOKEN=
# Signing Secret — App -> Basic Information -> App Credentials
SLACK_SIGNING_SECRET=
# Optional App-Level Token (xapp-...) if you use Socket Mode.
SLACK_APP_TOKEN=
# Comma separated list of channel IDs the bot monitors (C0XXXXXXX format).
# Leave empty to disable all channels until an admin configures them in the dashboard.
SLACK_CHANNELS=
# Reaction that triggers troubleshooting.
SLACK_TRIGGER_EMOJI=:troubleshoot:
# Also trigger when the bot is @mentioned. Keep false for strict reaction-only mode.
SLACK_ENABLE_MENTIONS=false
# Comma separated list of user IDs allowed to use the bot. Empty = everyone.
SLACK_ALLOWED_USERS=
# Verify Slack signing secrets on inbound events. Never disable in production.
SLACK_VERIFY_SIGNATURE=true
# Reject events whose timestamp is older than this (seconds) — anti-replay.
SLACK_SIGNATURE_MAX_AGE_SECONDS=300

# ------------------------------------------------------------------------------
# AI providers — at least one is required to answer Slack requests.
# Keys are encrypted at rest with CREDENTIAL_ENCRYPTION_KEY.
# Configure/override these from the dashboard: AI Providers page.
# ------------------------------------------------------------------------------
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# Troubleshooting behaviour
# ------------------------------------------------------------------------------
# Maximum AI troubleshooting turns before automatic escalation is recommended.
MAX_TROUBLESHOOTING_ATTEMPTS=6
# Escalate when an escalation is already open in the same channel.
ESCALATION_INFO_ITEMS=Approximate time the issue started,Device name and OS version,Slack username,Current error screenshot(s)
# Mark sessions stale/inactive after this many hours without agent activity.
SESSION_STALE_AFTER_HOURS=24
# Maximum number of screenshots sent to the AI per message.
MAX_SCREENSHOTS_PER_MESSAGE=4
# Maximum size (bytes) of a single Slack file the bot will analyse.
MAX_ATTACHMENT_BYTES=8388608
# Number of knowledge-base articles injected into a single AI request.
KB_MAX_ARTICLES=3
# Number of knowledge-base steps injected per article.
KB_MAX_STEPS=10

# ------------------------------------------------------------------------------
# Rate limiting (per IP unless stated otherwise)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
SLACK_EVENT_RATE_LIMIT_MAX=600

# ------------------------------------------------------------------------------
# Admin dashboard (apps/web)
# ------------------------------------------------------------------------------
# Vite dev server only. Set the API URL here if the dashboard runs on a different host.
VITE_API_URL=http://localhost:4000
